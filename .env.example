# Server
PORT=3000

# --- Observability / Cloud Logging ---
# These fields are stamped onto every structured log line and into the
# `serviceContext` block that Error Reporting groups by. APP_VERSION can be
# left blank locally; CI should stamp it with the git sha at deploy time.
APP_ENV=development
SERVICE_NAME=tracking-backend
APP_VERSION=

# Firestore credentials — pick ONE of the following options
# Option A: path to a service account JSON file on disk (standard Google SDK var)
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccount.json

# Option B: inline JSON of the service account (useful for containers/secret mgrs)
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...","client_email":"..."}

# Optional: explicit project id (only needed if the SDK can't infer it)
# GOOGLE_CLOUD_PROJECT=my-gcp-project

# Admin dashboard auth — required for the /api/* routes the frontend calls.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please
JWT_SECRET=replace-with-a-long-random-string-min-32-chars
# Comma-separated origins allowed to call the admin API (CORS).
# Use "*" only in dev. In prod, list your dashboard origin(s).
ADMIN_CORS_ORIGINS=http://localhost:5173

# Public base URL of THIS tracking backend — used to render tracking links
# in the admin UI (e.g. https://tracker.example.com).
PUBLIC_TRACKING_BASE_URL=http://localhost:3000

# --- Google Ads Integration (Optional) ---
# Required only if you intend to enable the Connections -> Google Ads feature.
# The redirect URI must exactly match the authorized URI in your Google Cloud Console.
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5173/oauth/google-ads/callback
GOOGLE_ADS_DEVELOPER_TOKEN=your-google-ads-developer-token
GOOGLE_OAUTH_STATE_SECRET=replace-with-32-byte-base64-string
GOOGLE_ADS_TOKEN_ENC_KEY=replace-with-32-byte-base64-string

# NOTE: FX rates are NOT configured here. They live in code, in
#   src/utils/fxRates.constants.ts  →  FX_RATES
# Edit that file to change a rate or add a currency. The old
# GOOGLE_ADS_FX_RATES env var was removed on purpose: two sources meant an env
# value could silently shadow the file and make an edit there look like a no-op.

# Optional: force all Google Ads conversion uploads into one currency. If unset,
# uploads use the destination account's own currency — which is usually what you
# want, since matching the account currency means Google performs no conversion
# of its own and the dashboard and Google Ads show identical numbers.
# GOOGLE_ADS_UPLOAD_CURRENCY=INR

# Optional: same override for Meta CAPI uploads. If unset, uploads use the
# destination ad account's own currency.
# META_UPLOAD_CURRENCY=INR

# NOTE: the fallback currency assumed when a network sends none AND has no
# default_currency configured also lives in code, as
#   src/utils/fxRates.constants.ts  →  FALLBACK_CONVERSION_CURRENCY  (= USD)
# Prefer setting default_currency per network (e.g. CNY for AliExpress) rather
# than changing that global — it applies to every network at once.
